DATABASE_URL=postgresql+psycopg://applypilot:applypilot@localhost:5450/applypilot
# Required, at least 32 random characters; the API and worker refuse to start with a placeholder.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Mark the session cookie Secure. Set true whenever the site is served over HTTPS.
COOKIE_SECURE=false

# Free to start at https://build.nvidia.com/ (NVIDIA Developer Program signup)
NVIDIA_API_KEY=nvapi-xxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
JOB_EXTRACTION_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
RESUME_PARSING_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
MATCH_SCORING_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
GENERATION_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

FILE_STORAGE_DIR=./storage/resumes
MAX_UPLOAD_MB=10
# Fernet key encrypting uploaded CV files at rest. Required; generate like EMAIL_ENCRYPTION_KEY.
# Changing it makes previously encrypted CV files unreadable.
RESUME_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3010

# Free key at https://developer.adzuna.com/ -- leave blank to skip Adzuna (crawl status will report it as not configured)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
CRAWL_INTERVAL_HOURS=1

# Tavily key: used for individual vacancy searches and company career discovery.
# Leave blank to skip company discovery (crawl status will report it as not configured)
TAVILY_API_KEY=

# Encrypts the connected SMTP account's password at rest. Required - the app will not start
# without it. Generate with:
# python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Changing this key after an email account has been connected makes the stored password
# undecryptable - the user will need to reconnect their account.
EMAIL_ENCRYPTION_KEY=
FOLLOWUP_INTERVAL_HOURS=6

# Bounded discovery and LLM work (no additional queue service)
SCORING_BATCH_SIZE=8
ENRICHMENT_BATCH_SIZE=8
DISCOVERY_MAX_JOBS=120
DISCOVERY_RUN_TIMEOUT_MINUTES=45
DISCOVERY_RETRY_HOURS=6
PORTFOLIO_REFRESH_HOURS=24

AI_TIMEOUT_SECONDS=60

# Background concurrency (per backend process)
SEARCH_WORKERS=3
BACKLOG_WORKERS=3
BACKLOG_PASS_SECONDS=120
RENDERED_FETCHES_PER_PASS=3
ORIGINAL_LOOKUPS_PER_PASS=2

# Run the scheduler inside the API process (single-process dev). In docker-compose the API
# sets this to false and the separate worker service runs background work.
RUN_SCHEDULER=true

# Reverse proxies whose X-Forwarded-For header uvicorn trusts (comma-separated IPs, or * only
# when the API is reachable exclusively through the proxy). Login rate limits are per client
# IP, so without this every user behind the proxy shares one limit.
FORWARDED_ALLOW_IPS=127.0.0.1
